[
  {
    "name": "on-github-event",
    "watch_path": "/github/webhook",
    "actions": [
      { "type": "command", "command": "echo 'github webhook fired'" }
    ],
    "enabled": false
  },
  {
    "name": "on-webhook-log",
    "watch_path": "/webhook",
    "actions": [
      { "type": "command", "command": "echo 'webhook received: {{body}}'" }
    ],
    "enabled": false
  },
  {
    "name": "review-github-event",
    "watch_path": "/github/webhook",
    "actions": [
      { "type": "agent", "job": "A GitHub event occurred. Review the payload and summarize what happened:\n{{body}}" }
    ],
    "enabled": false
  },
  {
    "name": "react-to-webhook",
    "watch_path": "/webhook",
    "actions": [
      { "type": "agent", "job": "A webhook was received. Analyze the payload and decide if any action is needed:\n{{body}}" }
    ],
    "enabled": false
  },
  {
    "name": "forward-github",
    "watch_path": "/github/webhook",
    "actions": [
      { "type": "webhook", "url": "https://example.com/hook", "method": "POST", "vars": { "source": "github" } }
    ],
    "enabled": false
  },
  {
    "name": "forward-webhook",
    "watch_path": "/webhook",
    "actions": [
      { "type": "webhook", "url": "https://example.com/hook", "method": "POST", "vars": { "source": "webhook" } }
    ],
    "enabled": false
  },
  {
    "name": "review-with-openai",
    "watch_path": "/github/webhook",
    "actions": [
      { "type": "agent", "job": "Review the GitHub event and summarize what happened:\n{{body}}", "llm_provider": "openai", "llm_model": "gpt-4o" }
    ],
    "enabled": false
  },
  {
    "name": "picklist-next25",
    "watch_path": "/webhook/picklist",
    "match": { "action": "next25" },
    "actions": [
      {
        "type": "command",
        "command": "cd /opt/bigman-engine/skills/active/picklist-ops && doppler run -p shared-services -c prd -- bash run.sh next25"
      }
    ],
    "enabled": true
  },
  {
    "name": "picklist-selected",
    "watch_path": "/webhook/picklist",
    "match": { "action": "selected" },
    "actions": [
      {
        "type": "command",
        "command": "cd /opt/bigman-engine/skills/active/picklist-ops && doppler run -p shared-services -c prd -- bash run.sh selected {{body.orders}}"
      }
    ],
    "enabled": true
  },
  {
    "name": "picklist-scan-return",
    "watch_path": "/webhook/picklist",
    "match": { "action": "scan-return" },
    "actions": [
      {
        "type": "command",
        "command": "cd /opt/bigman-engine/skills/active/picklist-ops && doppler run -p shared-services -c prd -- bash run.sh scan-return {{body.picklist_id}}"
      }
    ],
    "enabled": true
  }
]
